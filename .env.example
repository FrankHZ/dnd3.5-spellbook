# Local helper configuration.
# Copy to .env and keep the real value untracked.

DEPLOY_SSH_ALIAS=remote

# Private data repository. Relative paths resolve from the public repository root.
# Unset defaults to the legacy checkout-local data/ directory.
# DATA_REPO_PATH=../data

# Optional local operator tokens for Cloudflare API checks.
# Keep real values only in .env.
CLOUDFLARE_DNS_TOKEN=
CLOUDFLARE_WORKER_TOKEN=
